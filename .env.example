# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 绘画 API (豆包 Seedream / 火山引擎方舟)
PAINTING_API_KEY=your-painting-api-key
PAINTING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
PAINTING_MODEL=doubao-seedream-4-5-251128

# 视觉识图 API (可选，用于看懂用户发的图片)
VISION_API_KEY=

# 数据库 (PostgreSQL)。Vercel 上填 Neon / Supabase 给的连接串即可，
# postgres:// 和 ?sslmode=require 都会被自动识别。不再需要 Redis。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/virtual_gf

# 首次启动时自动创建的管理员账号 (可选)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT
SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# TTS
TTS_VOICE=zh-CN-XiaoxiaoNeural

# App
APP_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
